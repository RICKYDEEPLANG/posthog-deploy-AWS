# PostHog 部署配置模板
# 复制此文件为 .env 并填写实际值

# 安全密钥（部署时自动生成，或手动设置）
POSTHOG_SECRET=<your-secret-key>
ENCRYPTION_SALT_KEYS=<your-encryption-salt>

# 域名配置
DOMAIN=posthog.example.com
TLS_BLOCK=
REGISTRY_URL=posthog/posthog
CADDY_TLS_BLOCK=
CADDY_HOST="posthog.example.com, http://, https://"
POSTHOG_APP_TAG=latest

# AI API 配置 (OpenRouter)
OPENAI_API_KEY=<your-openrouter-api-key>
OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=<your-openrouter-api-key>
ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1

# 邮件配置
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_HOST_USER=<your-email-user>
EMAIL_HOST_PASSWORD=<your-email-password>
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=PostHog <noreply@example.com>
EMAIL_ENABLED=false

# 飞书登录
FEISHU_APP_ID=<your-feishu-app-id>
FEISHU_APP_SECRET=<your-feishu-app-secret>
